<?xml version="1.0"?>
<robot name="brazo_dibujante_kevin">
  <link name="base">
    <visual><geometry><cylinder radius="0.13" length="0.10"/></geometry></visual>
  </link>
  <link name="brazo1">
    <visual><origin xyz="0 0 0.14"/><geometry><cylinder radius="0.035" length="0.28"/></geometry></visual>
  </link>
  <joint name="base_joint" type="revolute">
    <parent link="base"/><child link="brazo1"/><origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/><limit lower="-1.57" upper="1.57" effort="20" velocity="2"/>
  </joint>
  <link name="brazo2">
    <visual><origin xyz="0 0 0.12"/><geometry><cylinder radius="0.03" length="0.24"/></geometry></visual>
  </link>
  <joint name="hombro_joint" type="revolute">
    <parent link="brazo1"/><child link="brazo2"/><origin xyz="0 0 0.28"/>
    <axis xyz="0 1 0"/><limit lower="-1.2" upper="1.2" effort="20" velocity="2"/>
  </joint>
  <link name="marcador">
    <visual><origin xyz="0 0 0.07"/><geometry><cylinder radius="0.012" length="0.14"/></geometry></visual>
  </link>
  <joint name="marcador_joint" type="prismatic">
    <parent link="brazo2"/><child link="marcador"/><origin xyz="0 0 0.24"/>
    <axis xyz="0 0 1"/><limit lower="0" upper="0.12" effort="10" velocity="0.5"/>
  </joint>
</robot>